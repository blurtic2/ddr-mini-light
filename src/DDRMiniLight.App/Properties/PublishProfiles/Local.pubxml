<?xml version="1.0" encoding="utf-8"?>
<!--
  로컬 실행용 게시 프로필: 저장소 루트의 output 폴더에 단일 exe를 만듭니다.
  .NET 8 Desktop Runtime이 설치된 PC용 (런타임 미포함, 약 0.5MB).

  명령줄: dotnet publish src/DDRMiniLight.App -p:PublishProfile=Local
  VS: 프로젝트 우클릭 → 게시 → Local
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>None</DebugType>
    <!-- 참조 프로젝트(Core)의 .pdb도 복사하지 않음 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\output\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>